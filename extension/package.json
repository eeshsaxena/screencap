{
  "name": "screencap-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Screencap browser tier — records browser work without the macOS app.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "provision": "node scripts/generate-provisioned.mjs",
    "verify-provisioned": "node scripts/verify-provisioned.mjs",
    "package": "npm run build && npm run provision && npm run verify-provisioned && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
