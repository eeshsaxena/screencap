# Stripe values for the billing Cloud Functions (billing.py).
#
# Copy this to `.env.stripe` (gitignored) and fill in TEST-MODE values for local
# deploys. NEVER commit real values. For LIVE keys, use GCP Secret Manager
# (`--set-secrets`) instead of a file — see billing.py's deploy docstring.
#
#   cp scripts/cloud-function/.env.example scripts/cloud-function/.env.stripe
#   # then fill in the three values below
#
# LIVE deploys go through `deploy_billing.sh`, which pulls STRIPE_SECRET_KEY and
# STRIPE_WEBHOOK_SECRET from Secret Manager by NAME (never a raw value here):
#   SECRET_STRIPE_SECRET_KEY=stripe-secret-key         # Secret Manager secret name
#   SECRET_STRIPE_WEBHOOK_SECRET=stripe-webhook-secret  # Secret Manager secret name
# The non-secret values below (price ids, portal config, trial days, URLs) are
# still passed via --set-env-vars.

# Developers -> API keys -> Secret key (test mode: sk_test_...)
STRIPE_SECRET_KEY=sk_test_...

# Two-tier prices (KTD-2). Create two RECURRING Stripe prices and set both here;
# the webhook maps a subscription's price back to a tier and the security
# invariant is subscribed = (tier == "cloud"). Must be non-empty + distinct.
#   Local Pro (records locally, no cloud upload): price_...
STRIPE_PRICE_ID_LOCAL=price_...
#   Cloud (adds cloud upload): price_...
STRIPE_PRICE_ID_CLOUD=price_...

# Legacy single $5/mo Price (Products -> Personal cloud). Keep its value here so
# the webhook grandfather-maps existing $5 subscribers to tier=cloud (R11). New
# checkouts use the two prices above; this is read only for the price->tier map.
STRIPE_PRICE_ID=price_...

# Card-required trial length in days (KTD-3). Checkout passes this alongside
# payment_method_collection='always'. Leave unset for no trial.
TRIAL_PERIOD_DAYS=7

# Developers -> Webhooks -> the endpoint's Signing secret: whsec_...
# (create the endpoint at the deployed stripe-webhook URL first)
STRIPE_WEBHOOK_SECRET=whsec_...

# Customer portal (create_portal_session, account-sheet plan U1). Where Stripe
# sends the user after they leave the hosted portal.
STRIPE_PORTAL_RETURN_URL=https://screencap.sh/account

# Saved portal configuration id (Settings -> Billing -> Customer portal, or the
# Portal Configurations API): bpc_... . Pins the two-product plan-switch
# allowlist in code (account-sheet U7). Live mode REQUIRES a saved
# configuration or Session.create fails.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
