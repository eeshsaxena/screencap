<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required: Python ctypes/cffi in PyInstaller bundles -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required: PyObjC/numpy .dylib files not signed by this team -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Add ONLY if binary crashes without it; document which component needs it.
         This entitlement disables W^X protection for the entire process. -->
    <!-- <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/> -->
</dict>
</plist>
