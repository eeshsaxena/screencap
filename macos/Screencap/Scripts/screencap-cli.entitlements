<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the embedded PyInstaller `screencap` CLI/daemon binary.

  The bundled binary is a CPython interpreter that dlopen()s ~340 native
  extension dylibs. Under hardened runtime (required for notarization) it needs:
    - allow-jit / allow-unsigned-executable-memory: CPython + native extensions
      allocate executable memory.
    - disable-library-validation: the bundle loads dylibs from many wheels; not
      all share our Team ID, and library validation would otherwise reject them.

  This is a SEPARATE entitlements set from the app's Screencap.entitlements —
  the helper binary has different needs (it does not, e.g., declare audio-input;
  TCC permissions are not entitlements).

  keychain-access-groups (SCR-241): lets this binary (the daemon + bundled CLI,
  one PyInstaller identity) read the cloud refresh token from a shared Keychain
  access group without a per-binary-ACL prompt. The group MUST be written as the
  LITERAL team-prefixed string: the raw codesign entitlements step (in
  embed-cli.sh and sign_app.sh) does NOT expand Xcode's $(TeamIdentifierPrefix),
  and it MUST match KEYCHAIN_ACCESS_GROUP in src/screencap/auth.py exactly. A
  binary signed under a different team can't claim this group and falls back to
  the legacy keyring path.

  keychain-access-groups is a RESTRICTED entitlement (SCR-242): AMFI SIGKILLs the
  binary at launch (exit 137 / "Killed: 9") unless an embedded Developer ID
  provisioning profile AUTHORIZES it. That authorization also requires the binary
  to declare com.apple.application-identifier (matching the profile's explicit
  App ID, 2A8S6MV8DZ.com.screencap.daemon) and com.apple.developer.team-identifier,
  and the helper .app must ship Contents/embedded.provisionprofile (embedded by the
  Developer ID re-sign, script/sign_app.sh, from SCREENCAP_DAEMON_PROVISION_PROFILE).
  Under an Apple Development identity these restricted entitlements are stripped at
  sign time, so the Xcode build phase (embed-cli.sh) defers the whole keychain
  authorization to that release re-sign. See
  docs/runbooks/scr-242-keychain-access-group-provisioning.md.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.application-identifier</key>
  <string>2A8S6MV8DZ.com.screencap.daemon</string>
  <key>com.apple.developer.team-identifier</key>
  <string>2A8S6MV8DZ</string>
  <key>keychain-access-groups</key>
  <array>
    <string>2A8S6MV8DZ.com.screencap.shared</string>
  </array>
</dict>
</plist>
